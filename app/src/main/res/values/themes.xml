<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SnappyDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/snappy_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/snappy_dialog_exit</item>
    </style>

    <style name="SnappySheetAnimation">
        <item name="android:windowEnterAnimation">@anim/snappy_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/snappy_sheet_exit</item>
    </style>

    <style name="SnappyDialogTheme" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:windowAnimationStyle">@style/SnappyDialogAnimation</item>
    </style>

    <style name="SnappyBottomSheetTheme" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:windowAnimationStyle">@style/SnappySheetAnimation</item>
    </style>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowAnimationStyle">@style/SnappyDialogAnimation</item>
        <item name="android:dialogTheme">@style/SnappyDialogTheme</item>
    </style>
</resources>
